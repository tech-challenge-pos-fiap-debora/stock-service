# Copia para .env (na raiz).
#
# Na máquina host (yarn migrate:up / yarn start:dev / testes):
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/stock
#
# Compose: host `postgres`. Kubernetes: host `stock-postgres`.
# postgresql://postgres:postgres@stock-postgres:5432/stock

# INTEGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/stock

JWT_SECRET=altere-este-segredo
JWT_EXPIRES_IN=1d
PORT=3000

SERVICE_NAME=stock-service
NEW_RELIC_APP_NAME=stock-service
NEW_RELIC_LABELS=service:stock-service;component:stock
# NEW_RELIC_LICENSE_KEY=
NEW_RELIC_ENABLED=false
